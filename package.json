{
  "name": "gik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/desktop.ps1 dev",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/desktop.ps1 build",
    "format": "prettier --write src tests scripts *.json *.ts *.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.json *.ts *.md .github/workflows/*.yml",
    "test:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
