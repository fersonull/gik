{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gik",
  "version": "0.1.0",
  "identifier": "app.gik.desktop",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://127.0.0.1:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [{"label":"main","title":"Gik","width":1440,"height":900,"minWidth":1024,"minHeight":640,"decorations":true}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"}
  },
  "bundle": {"active":true,"targets":["nsis"],"shortDescription":"A precise Git workbench","windows":{"webviewInstallMode":{"type":"downloadBootstrapper"},"nsis":{"installMode":"currentUser"}}}
}
